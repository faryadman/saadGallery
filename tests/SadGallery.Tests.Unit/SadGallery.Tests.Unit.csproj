<Project Sdk="Microsoft.NET.Sdk">

  <!--
    تست‌های واحد: سریع، بدون دیتابیس، بدون شبکه.
    تمرکز: محاسبات مالی، عیار/وزن/واحد، منطق وضعیت‌ها.
  -->
  <PropertyGroup>
    <RootNamespace>SadGallery.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 پروژه تست را به‌صورت اجرایی (Exe) می‌سازد و runner خودش را دارد -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- تست‌های واحد خواندن تنظیمات (Seed کاربران) — فقط InMemory provider لازم است -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SadGallery.Domain\SadGallery.Domain.csproj" />
    <ProjectReference Include="..\..\src\SadGallery.Application\SadGallery.Application.csproj" />
      <!-- ارجاع به Infrastructure فقط برای تستِ «پردازشگر واقعی تصویر» (SkiaSharp) است؛
           این تست‌ها هیچ دیتابیس یا شبکه‌ای لمس نمی‌کنند و همچنان سریع‌اند.
           بدون این ارجاع نمی‌شد رفتارِ واقعیِ رمزگشاییِ نمونه‌های مسموم را سنجید. -->
      <ProjectReference Include="..\..\src\SadGallery.Infrastructure\SadGallery.Infrastructure.csproj" />
  </ItemGroup>

</Project>
