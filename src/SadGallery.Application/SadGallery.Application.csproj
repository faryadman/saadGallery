<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SadGallery.Application — قراردادها، سرویس‌های کاربردی و قواعد جریان کار.
    وابستگی: فقط Domain (+ انتزاع‌های Microsoft.Extensions برای DI).
    ممنوع: EF Core، ASP.NET Core، دسترسی مستقیم به دیتابیس در این لایه.
  -->
  <PropertyGroup>
    <RootNamespace>SadGallery.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- انتزاع تنظیمات برای خواندن فهرست کاربران اولیه (ADR-0011)؛ پیاده‌سازی/فایل تنظیمات در لایه Web است -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SadGallery.Domain\SadGallery.Domain.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- نمونهٔ واقعی پاسخ سرویس نرخ (ارائه‌شده توسط مالک) برای منبع Fixture در توسعه/تست.
         این فایل داده بازار جاری نیست؛ برچسب «نمونهٔ آزمایشی» در نمایش الزامی است. -->
    <EmbeddedResource Include="Market\Fixture\tgn-sample.json" />
  </ItemGroup>
</Project>
