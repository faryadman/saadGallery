{
  "ConnectionStrings": { "SadGallery": "HOST_FROM_ENV" }, // مقدار واقعی فقط در Secret Store/ENV
  "RateOptions": {
    // منبع نرخ: Tgn (واقعی) | Fixture (نمونه، فقط Development) | Disabled (هیچ درخواستی ارسال نمی‌شود)
    "Provider": "Tgn",
    "EndpointTemplate": "https://webservice.tgnsrv.ir/Pr/Get/{username}/{password}",
    // اعتبارنامه‌ها عمداً خالی‌اند و فقط از ENV/User Secrets می‌آیند:
    // RateOptions__Username و RateOptions__Password (هرگز در مخزن نوشته نمی‌شوند)
    "Username": "",
    "Password": "",
    // دامنه‌های مجاز منبع نرخ (محافظت SSRF). دامنه واقعی سرویس مالک:
    "AllowedProviderDomains": [ "webservice.tgnsrv.ir" ],
    "FetchIntervalSeconds": 60,
    "StaleThresholdMinutes": 15,
    "MaxStaleHours": 24,
    "CacheTtlSeconds": 30,
    "MaxResponseBytes": 2097152,
    "HttpTimeoutSeconds": 10,
    "AnomalyChangeThresholdPercent": 50,
    "AnomalyPolicy": "ManualReview", // ManualReview | AutoAccept
    "MaxBackoffMinutes": 30,
    "StartupDelaySeconds": 5,
    "LeaseTtlSeconds": 0, // 0 = خودکار (مهلت HTTP + ۳۰ ثانیه)
    "FixtureShiftQuotedTimeToNow": true
  },
  "SecurityOptions": {
    "Pbkdf2Iterations": 600000, // اندازه‌گیری و ثبت در محیط واقعی؛ قابل ارتقا
    "Otp": {
      "Length": 6,
      "TtlSeconds": 120,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxPerDayPerIdentifier": 10
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "RateLimits": {
      "LoginPerMinute": 10,
      "OtpPerMinute": 3,
      "TicketPerHour": 5
    }
  },
  "StorageOptions": {
    // مسیرِ ذخیرهٔ فایل‌های بارگذاری‌شده (نسبت به ContentRoot، یا مطلق).
    // در استقرار واقعی آن را به مسیرِ مطلقی بیرون از پوشهٔ برنامه تغییر دهید
    // (مثلاً D:\SadGalleryMedia روی ویندوز یا /var/sadgallery/media روی لینوکس).
    // مقدارِ پیش‌فرضِ زیر روی هر دو سیستم کار می‌کند و هرگز توسط فایل‌های ایستا سرو نمی‌شود؛
    // تنها زیرپوشهٔ public به /media/products نقشه می‌شود.
    "UploadsRoot": "App_Data/media",
    "PublicSubPath": "public",
    "PrivateSubPath": "private",
    "PublicRequestPath": "/media/products",
    "MaxUploadBytes": 5242880,
    "MaxImagesPerProduct": 8,
    "MaxWidth": 8000,
    "MaxHeight": 8000,
    "StoredMaxSide": 1600,
    "ThumbnailSide": 480,
    "Quality": 82,
    "OutputFormat": "WebP"
    // نکتهٔ امنیتی: فهرستِ قالب‌های مجاز عمداً در کد ثابت است و از تنظیمات خوانده نمی‌شود؛
    // تصمیم بر پایهٔ «رمزگشاییِ واقعیِ» فایل است، نه پسوند و نه Content-Type.
  },
  "ProductOptions": {
    "HomeLatestCount": 8,
    "CatalogPageSize": 24,
    "PriceStaleAfterMinutes": 60,
    "MaxTitleLength": 200,
    "MaxSummaryLength": 400,
    "MaxDescriptionLength": 8000
  },
  "Serilog": { "MinimumLevel": { "Default": "Information" } }
}
