@model GoldAdminWalletModel
@{ ViewData["Title"] = "مدیریت کیف مشتری ویژه"; var wallet = Model.Data.Wallet; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-4"><div><h1 class="h4 mb-2">کیف مشتری ویژه</h1><p class="text-muted mb-0">@Model.Name · شناسه @PersianText.ToPersianDigits(Model.UserId.ToString())</p></div><a href="/admin/users" class="btn btn-outline-secondary sg-touch">فهرست کاربران</a></div>
@if (TempData["Notice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
<div asp-validation-summary="All" class="alert alert-danger sg-validation-summary" role="alert"></div>
@if (wallet != null) { <partial name="_Balances" model="wallet" /> }
<div class="row g-4"><div class="col-12 col-lg-5"><section class="sg-card h-100"><h2 class="h5 mb-3">دسترسی مشتری ویژه</h2><p class="small text-muted">فقط حساب فعال با نقش مشتری می‌تواند کیف ویژه داشته باشد. غیرفعال‌سازی، موجودی و سوابق را حفظ می‌کند؛ خرید جدید و تأیید خرید او متوقف می‌شود.</p>
<p>وضعیت: <strong>@(wallet?.Enabled == true ? "فعال" : "غیرفعال")</strong></p><form method="post" action="/admin/gold/wallets/@Model.UserId/enable">@Html.AntiForgeryToken()<input type="hidden" name="Version" value="@(wallet == null ? "" : Convert.ToBase64String(wallet.Version))" /><input type="hidden" name="Enabled" value="@(wallet?.Enabled == true ? "false" : "true")" /><button class="btn btn-outline-primary sg-touch">@(wallet?.Enabled == true ? "غیرفعال‌کردن مشتری ویژه" : "فعال‌کردن مشتری ویژه")</button></form></section></div>
<div class="col-12 col-lg-7"><section class="sg-card sg-compose-card h-100"><h2 class="h5 mb-3">شارژ کیف توسط مدیر</h2><p class="small text-muted">موجودی فعلی جایگزین نمی‌شود؛ مقدار واردشده به آن اضافه و با توضیح در دفتر ثبت قطعی نگهداری می‌شود. واحد را پیش از ثبت بررسی کنید.</p>
@if (wallet?.Enabled != true) { <div class="alert alert-info" role="status">برای ثبت شارژ، ابتدا «فعال‌کردن مشتری ویژه» را بزنید.</div> }
<form method="post" action="/admin/gold/wallets/@Model.UserId/credit">@Html.AntiForgeryToken()<input type="hidden" name="OperationId" value="@Model.Credit.OperationId" /><div class="row g-3"><div class="col-md-6"><label for="gold-credit-kind" class="form-label">نوع شارژ</label><select id="gold-credit-kind" name="Kind" class="form-select" required><option value="">انتخاب کنید</option><option value="TomanCredit" selected="@(Model.Credit.Kind == GoldLedgerKind.TomanCredit)">اعتبار تومان</option><option value="GoldCredit" selected="@(Model.Credit.Kind == GoldLedgerKind.GoldCredit)">طلا؛ گرم معادل عیار ۷۵۰</option></select></div><div class="col-md-6"><label for="gold-credit-amount" class="form-label">مقدار افزایش</label><input id="gold-credit-amount" name="Amount" value="@Model.Credit.Amount" class="form-control" inputmode="decimal" maxlength="40" required /></div><div class="col-12"><label for="gold-credit-reason" class="form-label">دلیل و مرجع شارژ</label><textarea id="gold-credit-reason" name="Reason" class="form-control" rows="3" minlength="3" maxlength="300" required>@Model.Credit.Reason</textarea></div></div><p class="small text-muted mt-2">تومان کامل؛ وزن طلا تا سه رقم اعشار (یک سوت).</p><button class="btn sg-btn-gold sg-touch mt-2" disabled="@(wallet?.Enabled != true)">ثبت افزایش موجودی</button></form></section></div></div>
<section class="sg-card mt-4"><h2 class="h5 mb-3">خریدهای مشتری</h2><partial name="_Orders" model="Model.Data.Orders" /></section><partial name="_Ledger" model="Model.Data.Ledger" />
<nav aria-label="صفحات کیف مشتری" class="d-flex gap-2 mt-3">@if (Model.Data.Orders.Number > 1) { <a href="/admin/gold/wallets/@Model.UserId?page=@(Model.Data.Orders.Number - 1)" class="btn btn-outline-secondary sg-touch">قبلی</a> }<span class="align-self-center">صفحه @PersianText.ToPersianDigits(Model.Data.Orders.Number.ToString())</span>@if (Model.Data.Orders.HasNext || Model.Data.Ledger.HasNext) { <a href="/admin/gold/wallets/@Model.UserId?page=@(Model.Data.Orders.Number + 1)" class="btn btn-outline-secondary sg-touch">بعدی</a> }</nav>
