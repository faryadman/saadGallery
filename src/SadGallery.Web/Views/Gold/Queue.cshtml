@model SadGallery.Application.Administration.Page<GoldOrderView>
@{ ViewData["Title"] = "صف خرید طلای آب‌شده"; var status = ViewData["Status"] as GoldOrderStatus?; var customerId = ViewData["CustomerId"] as int?; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-4"><div><h1 class="h4 mb-2">خرید طلای آب‌شده</h1><p class="small text-muted mb-0">بررسی درخواست‌ها، تأیید و ثبت قطعی یا آزادسازی اعتبار</p></div>@if (User.IsInRole(RoleNames.Admin)) { <a href="/admin/gold/settings" class="btn btn-outline-primary sg-touch">تنظیمات کارمزد و خرید</a> }</div>
<details class="sg-filter-disclosure mb-4" data-responsive-filters><summary class="sg-filter-toggle"><span>فیلترها</span>@if (status.HasValue || customerId.HasValue) { <span class="sg-filter-active">فعال</span> }</summary>
<form method="get" action="/operator/gold" class="sg-card sg-catalog-search"><div class="row g-3 align-items-end"><div class="col-12 col-md-4"><label for="gold-status" class="form-label">وضعیت خرید</label><select id="gold-status" name="status" class="form-select"><option value="">همه وضعیت‌ها</option><option value="Pending" selected="@(status == GoldOrderStatus.Pending)">در انتظار تأیید</option><option value="Approved" selected="@(status == GoldOrderStatus.Approved)">تأییدشده</option><option value="Rejected" selected="@(status == GoldOrderStatus.Rejected)">ردشده</option><option value="Cancelled" selected="@(status == GoldOrderStatus.Cancelled)">لغوشده</option></select></div><div class="col-12 col-md-4"><label for="gold-customer" class="form-label">شناسه مشتری</label><input id="gold-customer" name="customerId" value="@customerId" class="form-control" type="number" min="1" inputmode="numeric" /></div><div class="col-12 col-md-4 d-flex gap-2"><button class="btn btn-primary sg-touch">اعمال فیلتر</button><a href="/operator/gold?status=" class="btn btn-outline-secondary sg-touch">پاک‌کردن</a></div></div></form></details>
<section class="sg-card"><h2 class="h6 mb-3">@PersianText.ToPersianDigits(Model.Total.ToString()) درخواست</h2><partial name="_Orders" model="Model" /><nav aria-label="صفحات خریدها" class="d-flex gap-2 mt-3">@if (Model.Number > 1) { <a href="/operator/gold?page=@(Model.Number - 1)&amp;status=@status&amp;customerId=@customerId" class="btn btn-outline-secondary sg-touch">قبلی</a> }<span class="align-self-center">صفحه @PersianText.ToPersianDigits(Model.Number.ToString())</span>@if (Model.HasNext) { <a href="/operator/gold?page=@(Model.Number + 1)&amp;status=@status&amp;customerId=@customerId" class="btn btn-outline-secondary sg-touch">بعدی</a> }</nav></section>
