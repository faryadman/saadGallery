@model IReadOnlyList<SadGallery.Application.Tickets.TicketSummary>
@using SadGallery.Web.Models.Tickets
@{ ViewData["Title"] = "تیکت‌های من"; var list = new TicketListViewModel(Model, false); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h4 mb-1">تیکت‌های من</h1><p class="text-muted small mb-0">درخواست‌ها، وضعیت رسیدگی و پاسخ‌های پشتیبانی را پیگیری کنید.</p></div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/tickets/new" class="btn btn-primary sg-touch">تیکت جدید</a>
        <a href="/Member" class="btn btn-outline-secondary sg-touch">بازگشت به ناحیه اعضا</a>
    </div>
</div>
<partial name="_TicketFilters" model="list" />
<partial name="_TicketTable" model="list" />
