@model SadGallery.Web.Models.Tickets.CreateTicketForm
@using SadGallery.Domain.Tickets
@using SadGallery.Web.Models.Tickets
@{ ViewData["Title"] = "ثبت تیکت و استعلام قیمت"; }
<h1 class="h4 mb-3">ثبت تیکت و استعلام قیمت</h1>
<form method="post" action="/tickets/new">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <input asp-for="ProductId" type="hidden" />
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <label asp-for="Subject" class="form-label">موضوع</label>
            <input asp-for="Subject" class="form-control" maxlength="150" required autocomplete="off" />
            <span asp-validation-for="Subject" class="text-danger small"></span>
        </div>
        <div class="col-12 col-lg-4">
            <label asp-for="Type" class="form-label">نوع درخواست</label>
            <select asp-for="Type" class="form-select">
                @foreach (var type in Enum.GetValues<TicketType>())
                {
                    <option value="@((int)type)">@TicketLabels.Type(type)</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Body" class="form-label">پیام</label>
            <textarea asp-for="Body" class="form-control" maxlength="4000" rows="6" required aria-describedby="messageHelp"></textarea>
            <div id="messageHelp" class="form-text">رمز عبور، کد ورود یا اطلاعات بانکی نفرستید. حداکثر ۴۰۰۰ نویسه.</div>
            <span asp-validation-for="Body" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <button type="submit" class="btn btn-primary sg-touch">ثبت درخواست</button>
        <a href="/tickets" class="btn btn-outline-secondary sg-touch">انصراف</a>
    </div>
</form>
