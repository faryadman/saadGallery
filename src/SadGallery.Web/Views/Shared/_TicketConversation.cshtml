@model SadGallery.Application.Tickets.CustomerTicket
@using SadGallery.Web.Models.Tickets
<h1 class="h4 mb-3">@Model.Ticket.Subject</h1>
@if(Model.Ticket.RelatedProductId is { } productId) { <p><a href="/products/@productId">کالای مرتبط با درخواست</a></p> }
<p>شماره پیگیری: @Model.Ticket.TrackingCode · @TicketLabels.Type(Model.Ticket.Type) · @TicketLabels.Status(Model.Ticket.Status)</p>
<p>ثبت: @PersianDate.ToJalaliDateTimeText(Model.Ticket.CreatedAtUtc) · آخرین فعالیت: @PersianDate.ToJalaliDateTimeText(Model.Ticket.LastActivityAtUtc)</p>
@if(Model.Ticket.FirstResponseAtUtc is { } first) { <p>اولین پاسخ: @PersianDate.ToJalaliDateTimeText(first)</p> }
@if(Model.Ticket.ClosedAtUtc is { } closed) { <p>بسته‌شدن: @PersianDate.ToJalaliDateTimeText(closed)</p> }
@foreach(var message in Model.Messages)
{
    <article class="card my-3"><div class="card-body">
    <p>@(message.IsOperator ? "پشتیبانی" : "مشتری") · @PersianDate.ToJalaliDateTimeText(message.CreatedAtUtc)</p>
    <div style="white-space:pre-wrap">@message.Body</div>
    @if(message.Photos is { Count: > 0 })
    {
        <div class="sg-photo-grid mt-3">
        @foreach(var photo in message.Photos)
        {
            <figure class="sg-photo-tile mb-0">
                <a href="/tickets/photos/@photo.Id" target="_blank" rel="noopener" aria-label="نمایش عکس پیوست در اندازه بزرگ">
                    <img src="/tickets/photos/@photo.Id" alt="عکس پیوست این پیام" loading="lazy" width="@photo.Width" height="@photo.Height" />
                </a>
                <figcaption class="small text-muted p-2">عکس پیوست · <a href="/tickets/photos/@photo.Id" target="_blank" rel="noopener">نمایش کامل</a></figcaption>
            </figure>
        }
        </div>
    }
    </div></article>
}
