@using SadGallery.Application.Tickets
<div class="sg-photo-picker" data-photo-picker data-max-count="@TicketPhotoService.MaxPhotos" data-max-bytes="@TicketPhotoService.MaxFileBytes">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <label for="Photos" class="form-label fw-semibold mb-0">عکس‌های پیوست <span class="text-muted fw-normal small">(اختیاری)</span></label>
        <span class="small text-muted">حداکثر ۳ عکس</span>
    </div>
    <input id="Photos" name="Photos" type="file" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
           class="form-control" aria-label="انتخاب عکس‌های پیوست" aria-describedby="photoHelp" />
    <label for="Photos" class="sg-photo-zone" data-photo-drop hidden>
        <span class="sg-photo-icon" aria-hidden="true">＋</span>
        <strong>عکس را اینجا بکشید یا انتخاب کنید</strong>
        <span class="small text-muted">از محصول یا موضوع درخواست عکس بفرستید تا بررسی دقیق‌تر شود.</span>
        <span class="btn btn-outline-primary sg-touch mt-2">انتخاب عکس</span>
    </label>
    <div id="photoHelp" class="form-text mt-2">JPEG، PNG یا WebP؛ هر عکس حداکثر ۵ مگابایت. عکس‌ها فقط برای شما و پشتیبانی قابل مشاهده‌اند.</div>
    <p class="small text-muted mt-2 mb-0" data-photo-summary aria-live="polite">عکس‌های مرتبط را انتخاب کنید.</p>
    <div class="sg-photo-grid mt-3" data-photo-previews hidden></div>
    <div class="alert alert-danger mt-3 mb-0" data-photo-error role="alert" hidden></div>
    @Html.ValidationMessage("Photos", null, new { @class = "text-danger small d-block mt-2" })
    @if(Context.Request.Method == "POST")
    { <p class="small text-muted mt-2 mb-0">اگر ارسال ناموفق بود، عکس‌ها را دوباره انتخاب کنید؛ متن درخواست شما حفظ شده است.</p> }
</div>
