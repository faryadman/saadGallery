@inject SadGallery.Web.Pwa.PwaAssets PwaAssets
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] | گالری صاد</title>
    <meta name="theme-color" content="#10233f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="گالری صاد" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/pwa/icon.svg" />
    <link rel="apple-touch-icon" href="/pwa/icon-180.png" />
    <meta name="description" content="ویترین آنلاین طلا و جواهر صادگالری — نرخ روز طلا، مسکوکات، ارز و رمزارز" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-pwa-build="@PwaAssets.BuildId">
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        bool OnPath(string path) => path == "/" ? currentPath == "/" : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        string NavClass(string path) => OnPath(path) ? "nav-link active" : "nav-link";
        string? Current(string path) => OnPath(path) ? "page" : null;
        var toolsActive = OnPath("/market/bubble") || OnPath("/market/gold") || OnPath("/market/advanced-bubble");
        var managementActive = OnPath("/operator") || OnPath("/admin");
    }
    <header class="sg-header">
        <nav class="navbar navbar-expand-xl container" data-bs-theme="dark" aria-label="منوی اصلی">
            <a class="navbar-brand sg-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="sg-brand__mark">صاد</span>
                <span class="sg-brand__text">گالری صاد<small class="sg-mobile-brand-caption">SAD GALLERY</small></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sgNav"
                    aria-controls="sgNav" aria-expanded="false" aria-label="باز و بسته کردن منو">
                <span class="sg-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="sg-mobile-menu-label">منو</span>
                @if (User.Identity?.IsAuthenticated == true)
                { @await Component.InvokeAsync("TicketBadge", new { operatorQueue = User.IsInRole(RoleNames.Operator) || User.IsInRole(RoleNames.Admin) }) }
            </button>
            <a class="sg-mobile-quick sg-touch" href="@(User.Identity?.IsAuthenticated == true ? "/tickets" : "/Account/Login")"
               aria-label="@(User.Identity?.IsAuthenticated == true ? "تیکت‌های من" : "ورود به حساب")">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    @if (User.Identity?.IsAuthenticated == true)
                    { <path d="M21 12a8 8 0 0 1-8 8H5l-3 2V10a8 8 0 0 1 8-8h3a8 8 0 0 1 8 8Z" /><path d="M7 9h10M7 13h6" /> }
                    else
                    { <circle cx="12" cy="8" r="4" /><path d="M4 21v-2a8 8 0 0 1 16 0v2" /> }
                </svg>
            </a>
            <div class="collapse navbar-collapse" id="sgNav">
                <div class="sg-mobile-nav-heading"><span>دسترسی سریع</span><small>گالری صاد</small></div>
                <ul class="navbar-nav me-auto gap-xl-1 sg-primary-nav @(User.Identity?.IsAuthenticated == true ? "" : "sg-primary-nav--guest")">
                    <li class="nav-item"><a class="@NavClass("/")" href="/" aria-current="@Current("/")"><span class="sg-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8" /></svg></span>خانه</a></li>
                    <li class="nav-item"><a class="@(currentPath.Equals("/market", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link")" href="/market" aria-current="@(currentPath.Equals("/market", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="sg-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 20V10h4v10M10 20V4h4v16M16 20V7h4v13" /></svg></span>بازار</a></li>
                    <li class="nav-item"><a class="@NavClass("/products")" href="/products" aria-current="@Current("/products")"><span class="sg-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 8 4-5h10l4 5-9 13L3 8Zm0 0h18M7 3l5 18 5-18" /></svg></span>ویترین</a></li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle @(toolsActive ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">ابزارهای بازار</button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/market/bubble" aria-current="@Current("/market/bubble")">حباب‌سنج</a></li>
                            <li><a class="dropdown-item" href="/market/gold" aria-current="@Current("/market/gold")">ماشین‌حساب طلا</a></li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li><a class="dropdown-item" href="/market/advanced-bubble" aria-current="@Current("/market/advanced-bubble")">مقایسه حباب</a></li>
                            }
                        </ul>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="@NavClass("/tickets")" href="/tickets" aria-current="@Current("/tickets")"><span class="sg-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-8 8H5l-3 2V10a8 8 0 0 1 8-8h3a8 8 0 0 1 8 8Z" /><path d="M7 9h10M7 13h6" /></svg></span>تیکت‌های من @await Component.InvokeAsync("TicketBadge")</a></li>
                    }
                    @if (User.IsInRole(RoleNames.Operator) || User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle @(managementActive ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">مدیریت @await Component.InvokeAsync("TicketBadge", new { operatorQueue = true })</button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Operator/Dashboard">داشبورد اپراتور</a></li>
                                <li><a class="dropdown-item" href="/operator/reports">گزارش عملیاتی</a></li>
                                <li><a class="dropdown-item" href="/operator/gold">خرید طلای آب‌شده</a></li>
                                <li><a class="dropdown-item" href="/operator/tickets" aria-current="@Current("/operator/tickets")">صف تیکت‌ها @await Component.InvokeAsync("TicketBadge", new { operatorQueue = true })</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/Operator/Products" aria-current="@Current("/Operator/Products")">مدیریت کالاها</a></li>
                                <li><a class="dropdown-item" href="/Operator/Categories" aria-current="@Current("/Operator/Categories")">گروه‌بندی کالاها</a></li>
                                @if (User.IsInRole(RoleNames.Admin))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Admin/Dashboard">پنل مدیر</a></li>
                                    <li><a class="dropdown-item" href="/admin/users">کاربران و نقش‌ها</a></li>
                                    <li><a class="dropdown-item" href="/admin/settings">تنظیمات دریافت نرخ</a></li>
                                    <li><a class="dropdown-item" href="/admin/gold/settings">کارمزد و خرید آب‌شده</a></li>
                                    <li><a class="dropdown-item" href="/admin/audit">سابقه عملیات</a></li>
                                    <li><a class="dropdown-item" href="/admin/connection-notice" aria-current="@Current("/admin/connection-notice")">متن اعلان اتصال</a></li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav sg-account-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">حساب کاربری</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Member">ناحیه اعضا</a></li>
                                <li><a class="dropdown-item" href="/gold">کیف طلا و خرید آب‌شده</a></li>
                                <li><a class="dropdown-item" href="/market/history">تاریخچه نرخ‌ها</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="dropdown-item">خروج از حساب</button>
                                </form></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link sg-auth-link" href="/Account/Login">ورود</a></li>
                        <li class="nav-item"><a class="btn sg-btn-gold sg-touch sg-auth-link" href="/Account/Register">ثبت‌نام</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="sg-nav-backdrop" data-nav-backdrop aria-hidden="true" hidden></div>
    @await Component.InvokeAsync("ConnectionNotice")
    <partial name="_PwaUpdate" />

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="sg-footer">
        <div class="container py-3">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <span>گالری صاد — ویترین آنلاین طلا و جواهر · <a class="sg-install-link" href="/pwa/install">نصب برنامه</a> <button type="button" class="sg-pwa-recall" data-pwa-show-update hidden>به‌روزرسانی آماده</button></span>
                <span class="sg-footer__note">نرخ‌ها جهت اطلاع است و نرخ نهایی معامله در فروشگاه تعیین می‌شود.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/responsive-filters.js" asp-append-version="true"></script>
    <script src="~/js/mobile-navigation.js" asp-append-version="true"></script>
    <script src="~/js/offline-status.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    { <script src="~/js/ticket-notifications.js" asp-append-version="true"></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
