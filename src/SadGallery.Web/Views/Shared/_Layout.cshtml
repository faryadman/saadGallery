<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] | گالری صاد</title>
    <meta name="description" content="ویترین آنلاین طلا و جواهر صادگالری — نرخ روز طلا، مسکوکات، ارز و رمزارز" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="sg-offline-banner" role="alert">
        اتصال اینترنت شما قطع است؛ نرخ‌های نمایش‌داده‌شده «ذخیره‌شده» هستند و لحظه‌ای نیستند. پس از برقراری اتصال، صفحه را تازه کنید.
    </div>
    <header class="sg-header">
        <nav class="navbar navbar-expand-lg container">
            <a class="navbar-brand sg-brand" asp-controller="Home" asp-action="Index">
                <span class="sg-brand__mark">صاد</span>
                <span class="sg-brand__text">گالری صاد</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sgNav"
                    aria-controls="sgNav" aria-expanded="false" aria-label="نمایش منو">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="sgNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">خانه</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="Index">بازار</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="Bubble">حباب‌سنج</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="Gold">ماشین‌حساب طلا</a></li>
                    <li class="nav-item"><span class="nav-link sg-navlink--soon" title="فاز ۴">محصولات <small>(به‌زودی)</small></span></li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Market" asp-action="History">تاریخچه نرخ‌ها</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Member" asp-action="Index">ناحیه اعضا</a></li>
                        @if (User.IsInRole(RoleNames.Operator) || User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Operator" asp-controller="Dashboard" asp-action="Index">پنل اپراتور</a></li>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">پنل مدیر</a></li>
                        }
                        <li class="nav-item">
                            <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">خروج</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">ورود</a></li>
                        <li class="nav-item"><a class="btn btn-sm sg-btn-gold ms-2" asp-controller="Account" asp-action="Register">ثبت‌نام</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="sg-footer">
        <div class="container py-3">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <span>گالری صاد — ویترین آنلاین طلا و جواهر</span>
                <span class="sg-footer__note">نرخ‌ها جهت اطلاع است و نرخ نهایی معامله در فروشگاه تعیین می‌شود.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/offline-status.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
