@model SadGallery.Application.Administration.Page<SadGallery.Application.Administration.AuditRow>
@using SadGallery.Application.Administration
@{ ViewData["Title"] = "سابقه عملیات"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><div><h1 class="h4 mb-2">سابقه عملیات</h1><p class="small text-muted mb-0">تغییرهای حساس حساب‌ها، تنظیمات، محصولات و تیکت‌ها</p></div><div class="d-flex gap-2"><a href="/admin/audit.csv" class="btn btn-primary sg-touch">دریافت CSV</a><a href="/Admin/Dashboard" class="btn btn-outline-secondary sg-touch">پنل مدیر</a></div></div>
<section class="sg-card"><p class="small text-muted">خروجی شامل آخرین ۵۰۰ رخداد است. زمان، عامل و نام فیلد تغییرکرده ثبت می‌شود؛ متن مکاتبه و اطلاعات محرمانه در گزارش قرار نمی‌گیرد.</p>
@if(Model.Items.Count == 0) { <p class="mb-0">هنوز عملیاتی ثبت نشده است.</p> }
else {
<p class="small text-muted d-lg-none mb-2">برای دیدن همه ستون‌ها، جدول را افقی جابه‌جا کنید.</p><div class="table-responsive" tabindex="0" role="region" aria-label="جدول سابقه عملیات"><table class="table table-hover align-middle sg-table sg-admin-table sg-audit-table"><thead><tr><th scope="col">زمان و عامل</th><th scope="col">عملیات</th><th scope="col">هدف و فیلدها</th><th scope="col">درخواست</th></tr></thead><tbody>
@foreach(var item in Model.Items) { <tr><td>@PersianDate.ToJalaliDateTimeText(item.AtUtc)<span class="d-block small text-muted">کاربر @PersianText.ToPersianDigits(item.ActorId?.ToString() ?? "—")</span></td><td>@AdminRules.ActionTitle(item.Action)</td><td><bdi>@item.EntityType · @item.EntityId</bdi><small class="d-block"><bdi>@item.Fields</bdi></small></td><td><bdi>@(item.IpAddress ?? "—")</bdi><small class="d-block"><bdi>@item.CorrelationId</bdi></small></td></tr> }
</tbody></table></div> }
<nav aria-label="صفحات رخدادها" class="d-flex flex-wrap gap-2 mt-3">
@if(Model.Number > 1) { <a href="/admin/audit?page=@(Model.Number-1)" class="btn btn-outline-secondary sg-touch">قبلی</a> }
<span class="align-self-center small">صفحه @PersianText.ToPersianDigits(Model.Number.ToString()) · @PersianText.ToPersianDigits(Model.Total.ToString()) رخداد</span>
@if(Model.HasNext) { <a href="/admin/audit?page=@(Model.Number+1)" class="btn btn-outline-secondary sg-touch">بعدی</a> }
</nav></section>
