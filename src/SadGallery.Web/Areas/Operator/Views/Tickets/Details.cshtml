@model SadGallery.Application.Tickets.OperatorTicket
@using SadGallery.Domain.Tickets
@using SadGallery.Web.Models.Tickets
@{ ViewData["Title"] = "بررسی تیکت"; }
<partial name="_TicketConversation" model="Model.Public" />
<p>اپراتور مسئول: @(Model.Public.Ticket.AssignedOperatorUserId?.ToString() ?? "تعیین نشده")</p>
<h2>یادداشت‌های داخلی</h2>
@foreach(var note in Model.InternalNotes) { <article class="card my-2"><div class="card-body"><p>@PersianDate.ToJalaliDateTimeText(note.CreatedAtUtc)</p><div style="white-space:pre-wrap">@note.Body</div></div></article> }
<form method="post" action="/operator/tickets/@Model.Public.Ticket.Id">
@Html.AntiForgeryToken()
<input type="hidden" name="RowVersion" value="@Convert.ToBase64String(Model.Public.RowVersion)" />
<label for="body">پیام یا یادداشت</label><textarea id="body" name="Body" class="form-control" rows="5" maxlength="4000"></textarea>
<label><input type="checkbox" name="InternalNote" value="true" /> یادداشت داخلی (حداکثر ۲۰۰۰ نویسه؛ برای مشتری نمایش داده نمی‌شود)</label>
<label for="status">وضعیت بعدی</label><select id="status" name="Status" class="form-select"><option value="">بدون تغییر</option>
@foreach(var s in Enum.GetValues<TicketStatus>().Where(s => TicketWorkflow.CanTransition(Model.Public.Ticket.Status,s))) { <option value="@((int)s)">@TicketLabels.Status(s)</option> }
</select>
<p>برای پاسخ عمومی، وضعیت را «پاسخ داده‌شده» یا «منتظر پاسخ شما» انتخاب کنید. تیکت جدید ابتدا باید در حال بررسی شود.</p>
<label for="assign">شناسه اپراتور فعال برای ارجاع</label><input id="assign" name="AssignTo" type="number" min="1" class="form-control" />
<button class="btn sg-btn-gold mt-3" type="submit">ثبت تغییر</button></form>

<h2>تاریخچه تغییرات</h2>
<ul>@foreach(var entry in Model.History) { <li>@PersianDate.ToJalaliDateTimeText(entry.CreatedAtUtc) · @TicketLabels.Event(entry.Kind) · کاربر @entry.ActorUserId</li> }</ul>
