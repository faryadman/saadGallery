@model IReadOnlyList<SadGallery.Application.Tickets.TicketSummary>
@using SadGallery.Web.Models.Tickets
@{ ViewData["Title"] = "صف تیکت‌ها"; var list = new TicketListViewModel(Model, true); }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h4 mb-1">صف تیکت‌ها</h1><p class="text-muted small mb-0">درخواست‌ها را بررسی کنید، پاسخ دهید و پس از رسیدگی به اتمام برسانید.</p></div>
    <div class="d-flex flex-wrap gap-2">
        <a href="/tickets/new" class="btn btn-primary sg-touch">تیکت جدید</a>
        <a href="/Operator/Dashboard" class="btn btn-outline-secondary sg-touch">بازگشت به پنل</a>
    </div>
</div>
@if(TempData["Notice"] is string notice)
{ <div class="alert alert-success" role="status">@notice</div> }
@if(!ViewData.ModelState.IsValid)
{ @Html.ValidationSummary(false, "ثبت وضعیت انجام نشد", new { @class = "alert alert-danger", role = "alert" }) }
<partial name="_TicketFilters" model="list" />
<partial name="_TicketTable" model="list" />
