<!--
  Directory.Build.props — تنظیمات مشترک همه پروژه‌های SadGallery
  قاعده پروژه: صفر هشدار. هر هشدار = خطای Build (TreatWarningsAsErrors).
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>fa</NeutralLanguage>

    <!-- هویت محصول در Metadata اسمبلی‌ها -->
    <Company>SadGallery</Company>
    <Product>SadGallery</Product>
    <Copyright>SadGallery — مالک پروژه</Copyright>
    <Version>0.1.0</Version>

    <!-- قواعد EF/Identity که با تنظیمات پیش‌فرض هشدار می‌دهند -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- کد تولیدشده توسط ابزارها (Migration/obj) مشمول سخت‌گیری تحلیلگرها نمی‌شود -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SadGallery.Infrastructure'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
