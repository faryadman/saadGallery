# تنظیمات ویرایشگر برای پروژه SadGallery
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,js,ts,css,scss,yml,yaml,csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion

# قواعد امنیتی: نبود این‌ها با خطا متوقف می‌شود (برای فازهای بعد فعال است)
dotnet_diagnostic.CA5350.severity = warning
dotnet_diagnostic.CA5363.severity = warning
dotnet_diagnostic.CA5364.severity = warning
dotnet_diagnostic.CA5394.severity = warning
dotnet_diagnostic.CA5402.severity = warning
dotnet_diagnostic.SYSLIB1045.severity = suggestion
